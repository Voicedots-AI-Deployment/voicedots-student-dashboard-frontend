{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/reports/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/practice",
      "destination": "/index.html"
    },
    {
      "source": "/placements",
      "destination": "/index.html"
    },
    {
      "source": "/reports",
      "destination": "/index.html"
    },
    {
      "source": "/growth",
      "destination": "/index.html"
    },
    {
      "source": "/profile",
      "destination": "/index.html"
    },
    {
      "source": "/resume-studio",
      "destination": "/index.html"
    },
    {
      "source": "/coach",
      "destination": "/index.html"
    },
    {
      "source": "/coach/session",
      "destination": "/index.html"
    },
    {
      "source": "/academics",
      "destination": "/index.html"
    },
    {
      "source": "/career",
      "destination": "/index.html"
    },
    {
      "source": "/erp",
      "destination": "/index.html"
    },
    {
      "source": "/erp/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/student-api-config.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
